generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Auth (NextAuth v5 with Prisma adapter)
// ─────────────────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events            Event[]
  templates         Layout[]             @relation("UserTemplates")
  accounts          Account[]
  sessions          Session[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String
  p256dh    String
  auth      String
  userAgent String?

  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// Event domain
// ─────────────────────────────────────────────────────────────
enum EventStatus {
  DRAFT
  LIVE
  ENDED
}

enum WalkInMode {
  AUTO_SEAT
  REQUIRE_HOST_APPROVAL
}

enum LookupPrivacy {
  PUBLIC
  CODE_PROTECTED
}

model Event {
  id            String      @id @default(cuid())
  hostUserId    String
  host          User        @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  name          String
  date          DateTime?
  venueName     String?
  startsAt      DateTime?
  status        EventStatus @default(DRAFT)

  allowWalkIns  Boolean     @default(true)
  walkInMode    WalkInMode  @default(REQUIRE_HOST_APPROVAL)

  lookupPrivacy LookupPrivacy @default(PUBLIC)
  eventCode     String?
  publicSlug    String      @unique

  noShowAutoFlagMinutes Int @default(45)

  // Lowercased landmark labels the planner explicitly removed from this event's QR set.
  // Used by /api/events/[id]/qr/bulk-auto to skip re-creating those landmarks on sync.
  omittedLandmarkLabels String[] @default([])

  layoutId      String?     @unique
  layout        Layout?     @relation("EventLayout", fields: [layoutId], references: [id])

  guests        Guest[]
  qrCodes       QRCode[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([hostUserId])
}

model Layout {
  id                 String   @id @default(cuid())
  name               String
  sourceImageUrl     String
  sourceImageWidth   Int
  sourceImageHeight  Int

  isTemplate         Boolean  @default(false)
  templateName       String?
  templateOwnerId    String?
  templateOwner      User?    @relation("UserTemplates", fields: [templateOwnerId], references: [id])

  event              Event?   @relation("EventLayout")
  tables             Table[]
  landmarks          Landmark[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([templateOwnerId])
}

model Landmark {
  id        String   @id @default(cuid())
  layoutId  String
  layout    Layout   @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  label     String
  xPct      Float
  yPct      Float

  createdAt DateTime @default(now())

  @@index([layoutId])
}

model Table {
  id              String   @id @default(cuid())
  layoutId        String
  layout          Layout   @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  label           String
  capacity        Int      @default(8)

  xPct            Float
  yPct            Float

  /// @deprecated Use TableDirection. Kept for backward-compat; new code reads from TableDirection.
  directionsText  String?
  notes           String?

  seats           Seat[]
  guests          Guest[]  @relation("TableGuests")
  qrCodes         QRCode[] @relation("TableQRs")
  directions      TableDirection[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([layoutId])
}

model TableDirection {
  id              String   @id @default(cuid())
  tableId         String
  table           Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  fromQrId        String?
  fromQr          QRCode?  @relation(fields: [fromQrId], references: [id], onDelete: Cascade)

  directionsText  String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tableId])
  @@index([fromQrId])
}

model Seat {
  id              String  @id @default(cuid())
  tableId         String
  table           Table   @relation(fields: [tableId], references: [id], onDelete: Cascade)

  seatNumber      Int

  assignedGuestId String? @unique
  assignedGuest   Guest?  @relation("SeatAssignment", fields: [assignedGuestId], references: [id])

  @@unique([tableId, seatNumber])
  @@index([tableId])
}

model Guest {
  id                  String   @id @default(cuid())
  eventId             String
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  firstName           String
  lastName            String

  assignedTableId     String?
  assignedTable       Table?   @relation("TableGuests", fields: [assignedTableId], references: [id], onDelete: SetNull)
  assignedSeat        Seat?    @relation("SeatAssignment")

  groupTag            String?

  plusOneOfGuestId    String?
  plusOneOf           Guest?   @relation("PlusOneRelation", fields: [plusOneOfGuestId], references: [id])
  plusOnes            Guest[]  @relation("PlusOneRelation")
  isPlusOnePlaceholder Boolean @default(false)

  notes               String?

  checkedInAt         DateTime?
  isWalkIn            Boolean  @default(false)
  noShowFlaggedAt     DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([eventId])
  @@index([eventId, lastName])
  @@index([assignedTableId])
}

model QRCode {
  id              String  @id @default(cuid())
  eventId         String
  event           Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  label           String
  scanOriginXPct  Float
  scanOriginYPct  Float

  tableId         String?
  table           Table?  @relation("TableQRs", fields: [tableId], references: [id], onDelete: SetNull)

  qrImageUrl      String?

  directions      TableDirection[]

  createdAt       DateTime @default(now())

  @@index([eventId])
  @@index([tableId])
}

model WalkInRequest {
  id          String   @id @default(cuid())
  eventId     String
  firstName   String
  lastName    String
  qrId        String?
  status      String   @default("PENDING")
  guestId     String?
  notes       String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([eventId])
  @@index([eventId, status])
}
